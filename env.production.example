# Copy this template OUTSIDE the checkout (for example /etc/dwc/dwc.env),
# restrict it to the deploy account (chmod 600), and pass it with --env-file.
# Never commit populated production values.

# Required deployment coordinates (non-secret)
COMPOSE_PROJECT_NAME=dwc-production
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=
WEB_IMAGE=dwc-web
WEB_IMAGE_TAG=
POSTGRES_VOLUME_NAME=dwc_postgres_data
NEXT_PUBLIC_SITE_URL=https://deliciouswines.org

# Required database settings (POSTGRES_PASSWORD and DATABASE_URL are secrets)
POSTGRES_DB=dwc
POSTGRES_USER=dwc
POSTGRES_PASSWORD=
DATABASE_URL=

# Required application secret (generate independently; at least 32 random bytes)
AUTH_SECRET=

# Optional integrations; leave blank to disable the corresponding feature
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_POST=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_SHOP=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
